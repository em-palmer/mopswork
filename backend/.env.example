# Adzuna API — https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# SerpAPI (Google Jobs) — https://serpapi.com/
SERPAPI_API_KEY=

# Jooble API — https://jooble.org/api/about (free, no credit card)
JOOBLE_API_KEY=

# Careerjet API — https://www.careerjet.co.uk/partners/api (free non-commercial)
CAREERJET_API_KEY=

# Apify API — https://console.apify.com (free $5/mo credits for LinkedIn scraping)
APIFY_API_TOKEN=

# ScrapingDog Jobs API (LinkedIn search) — https://www.scrapingdog.com (free credits, 5 per job search)
SCRAPINGDOG_API_KEY=

# ScrapingBee — https://www.scrapingbee.com (1,000 free credits; used to unblock Indeed HTML)
SCRAPINGBEE_API_KEY=

# JSearch (OpenWeb Ninja) — https://www.openwebninja.com/api/jsearch
# Header X-API-Key, endpoint https://api.openwebninja.com/jsearch/search-v2
JSEARCH_API_KEY=

# Scrapfly — https://scrapfly.io (1,000 free credits; Indeed/JS unblocker)
SCRAPFLY_API_KEY=